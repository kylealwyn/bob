#!/usr/bin/env bash
# checkin — one line per spawned worker in this repo with the signals that show
# drift: minutes into its current turn, commits ahead of the default branch,
# uncommitted files, stray tmp files, and its PR with that PR's CI. Then one
# line per open workspace whose agent is gone. The groom reads flagged panes.
#
#   checkin            all named agents in this repo
#   checkin <slug>...  only these
#
# Flags: TURN>30m, DIRTY>8 files, TMP files present, NOPR with commits ahead and
# no open PR or merged PR at HEAD, CIFAIL on the open PR, NOAGENT.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
require_herdr

all=$(repo_agents)
want=""
[[ $# -gt 0 ]] && want=" $* "
gh=$(gh_repo)

# The open PR with its CI rolled up, else the merged PR whose head is HEAD.
# Cancelled, timed-out, and action-required checks count as failures.
pr_jq='
  def ci: [.statusCheckRollup[] |
      (.conclusion // "") as $c | (.state // "") as $s |
      if ([$c, $s] | any(IN("FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "ERROR"))) then "fail"
      elif ((.status // "COMPLETED") != "COMPLETED") or ($s | IN("PENDING", "EXPECTED")) then "pending"
      else "pass" end]
    | if length == 0 then "none" elif index("fail") then "fail" elif index("pending") then "pending" else "pass" end;
  (map(select(.state == "OPEN"))[0]) as $open
  | if $open then "#\($open.number) ci:\($open | ci)"
    else (map(select(.state == "MERGED" and .headRefOid == $head))[0] // empty | "#\(.number) merged") end'

printf '%-24s %-8s %6s %5s %5s %4s  %s\n' agent status turn ahead dirty tmp pr/flags
while IFS= read -r a; do
  [[ -n "$a" ]] || continue
  name=$(jq -r .name <<<"$a"); cwd=$(jq -r .cwd <<<"$a"); status=$(jq -r .agent_status <<<"$a")
  [[ -n "$want" && "$want" != *" $name "* ]] && continue
  # A working Claude pane shows the live turn's elapsed time as "(37m 53s ·" or "(53s ·".
  turn="-"
  if [[ "$status" == working ]]; then
    el=$(herdr agent read "$name" --source visible | grep -oE '\(([0-9]+h )?([0-9]+m )?[0-9]+s ·' | tail -1 || true)
    h=$(grep -oE '[0-9]+h' <<<"$el" | tr -d h || true); m=$(grep -oE '[0-9]+m' <<<"$el" | tr -d m || true)
    [[ -n "$el" ]] && turn=$(( ${h:-0} * 60 + ${m:-0} ))m
  fi
  branch=$(git -C "$cwd" branch --show-current)
  head=$(git -C "$cwd" rev-parse HEAD)
  ahead=$(git -C "$cwd" rev-list --count "$base..HEAD")
  porcelain=$(git -C "$cwd" status --porcelain --untracked-files=all)
  dirty=$(grep -c . <<<"$porcelain" || true)
  tmp=$(cut -c4- <<<"$porcelain" | grep -ciE '(^|/)tmp([-_./]|$)|\.tmp\.' || true)
  pr=""
  if [[ -n "$branch" ]]; then
    pr=$(gh pr list --repo "$gh" --head "$branch" --state all --json number,state,headRefOid,statusCheckRollup |
      jq -r --arg head "$head" "$pr_jq")
  fi
  flags=""
  [[ "$turn" != "-" && "${turn%m}" -gt 30 ]] && flags+=" TURN>30m"
  (( dirty > 8 )) && flags+=" DIRTY"
  (( tmp > 0 )) && flags+=" TMP"
  [[ -z "$pr" && "$ahead" -gt 0 ]] && flags+=" NOPR"
  [[ "$pr" == *ci:fail ]] && flags+=" CIFAIL"
  printf '%-24s %-8s %6s %5s %5s %4s  %s%s\n' "$name" "$status" "$turn" "$ahead" "$dirty" "$tmp" "$pr" "$flags"
done < <(jq -c 'select(.name) | {name, cwd, agent_status}' <<<"$all")

# A worker whose agent quit or crashed leaves its workspace open with no agent.
live=$(jq -r '.workspace_id' <<<"$all" | sort -u)
herdr worktree list --cwd "$repo" | jq -r --arg repo "$repo" \
  '.result.worktrees[] | select(.open_workspace_id and .path != $repo) | "\(.open_workspace_id) \(.path)"' |
  while read -r workspace path; do
    slug=$(basename "$path")
    [[ -n "$want" && "$want" != *" $slug "* ]] && continue
    grep -qx "$workspace" <<<"$live" || printf '%-24s %-8s %6s %5s %5s %4s  %s\n' "$slug" gone - - - - NOAGENT
  done
