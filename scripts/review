#!/usr/bin/env bash
# review [--note <file>] — two fresh-context frontier reviews of HEAD against
# the default branch, in parallel, written under <git dir>/bob-review/<head>/:
#
#   codex.md   `codex review` on Codex's default model
#   fable.md   `claude -p --model claude-fable-5-1`, modes/review.md as the
#              procedure; opens with the model ID Claude reports using
#
# Then one line goes to stdout and, as a comment, to the branch's open PR, where
# the Foreman reads it: `Bob review at <sha>: Codex <findings> · Fable <verdict>`.
# Untagged Codex output is quoted, never read as clean.
#
# --note <file> reviews a design note (modes/review.md, Design notes). With no
# commits yet, Fable reviews the note alone; with commits (the first interface
# commit), both review the diff with the note as its specification. The line
# reads `Bob design review ...`; post it with the note to the tracker item.
#
# Run it in the worker's worktree with everything committed, and don't commit
# while it runs; it fails if the worktree changed. Neither reviewer may read the
# terminal (a CLI waiting on stdin hangs forever). Fable gets read-only tools and
# no MCP servers, since the PR text and diff are untrusted. Reports go away with
# the worktree on close; the PR comment is the record.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
note=""
if [[ "${1:-}" == --note ]]; then
  note=$(cd "$(dirname "${2:?usage: review [--note <file>]}")" && pwd)/$(basename "$2")
  [[ -s "$note" ]] || die "design note is empty or missing: $2"
fi
modes="$(cd "$(dirname "$0")/.." && pwd)/modes"
worktree=$(git rev-parse --show-toplevel)

[[ -z "$(git status --porcelain)" ]] || die "uncommitted changes; commit them so the review pins an exact head"
git fetch origin --quiet
head=$(git rev-parse HEAD)
branch=$(git branch --show-current)
commits=$(git rev-list "$base..$head")
[[ -n "$commits" || -n "$note" ]] || die "HEAD has no commits beyond $base"

out="$(git rev-parse --path-format=absolute --git-dir)/bob-review/$head"
mkdir -p "$out"

# Only an open PR: a reused branch name can also match an old merged one.
gh=$(gh_repo)
pr_number=""; pr=""
if [[ -n "$branch" ]]; then
  pr_number=$(gh pr list --repo "$gh" --head "$branch" --state open --json number --jq '.[0].number // empty')
  [[ -z "$pr_number" ]] || pr=$(gh pr view "$pr_number" --repo "$gh" --json number,title,body \
    --jq '"#\(.number) \(.title)\n\n\(.body)"')
fi

{
  cat "$modes/review.md"
  printf '\n---\n\nReview this artifact with the procedure above. You are read-only: do not edit files.\n\n'
  printf 'Repository: %s\nReviewed: %s at %s against %s (merge base %s)\n\n' \
    "$worktree" "${branch:-detached}" "$head" "$base" "$(git merge-base "$base" "$head")"
  if [[ -n "$note" ]]; then
    printf 'This is a design review: follow the Design notes section above.\n\n## Design note\n\n'; cat "$note"; printf '\n\n'
  fi
  printf '## Pull request\n\n%s\n\n' "${pr:-none open}"
  if [[ -n "$commits" ]]; then
    printf '## Commits\n\n'; git log --format='%h %s%n%n%b' "$base..$head"
    printf '\n## Diff\n\n```diff\n'; git diff "$base...$head"; printf '```\n'
  fi
} >"$out/fable-prompt.md"

# A note with no code yet has no diff for Codex to review.
codex_pid=""
if [[ -n "$commits" ]]; then
  codex review --base "$base" </dev/null >"$out/codex.md" 2>"$out/codex.log" &
  codex_pid=$!
fi

fable() {
  local json
  # On failure Claude explains itself in the JSON on stdout; keep it.
  json=$(claude -p --model claude-fable-5-1 --output-format json --tools Read,Grep,Glob --strict-mcp-config <"$out/fable-prompt.md") \
    || { printf '%s\n' "$json" >&2; return 1; }
  jq -r '"Model: \(.modelUsage | keys | join(", "))\n\n\(.result)"' <<<"$json" >"$out/fable.md"
  [[ "$(jq -r .is_error <<<"$json")" == false ]]
}
fable 2>"$out/fable.log" &
fable_pid=$!

status=0
[[ -z "$codex_pid" ]] || wait "$codex_pid" || { echo "codex review failed; see $out/codex.log" >&2; status=1; }
wait "$fable_pid" || { echo "fable review failed; see $out/fable.log" >&2; status=1; }

[[ "$(git rev-parse HEAD)" == "$head" && -z "$(git status --porcelain)" ]] \
  || { echo "the worktree changed during review; the reports may not match $head. Rerun." >&2; status=1; }
[[ -z "$codex_pid" || -s "$out/codex.md" ]] || { echo "codex review wrote no report; see $out/codex.log" >&2; status=1; }

for f in codex fable; do [[ -s "$out/$f.md" ]] && printf '%s  %s\n' "$f" "$out/$f.md"; done
(( status == 0 )) || exit "$status"

# One summary line, also posted on the open PR: the Foreman reads verdicts
# there at the exact head, and the record outlives the worktree.
findings=$([[ -z "$codex_pid" ]] || grep -oE '^- \[P[0-9]\]' "$out/codex.md" | grep -oE 'P[0-9]' | sort | uniq -c | awk '{printf "%s%s x%s", sep, $2, $1; sep=", "}' || true)
# Fable sometimes bolds or bullets the line (`**Verdict: pass**`, `- Verdict: pass`);
# strip Markdown emphasis and list markers before matching, so a real verdict
# never reads as "no verdict line" and earns a needless re-roll.
verdict=$(sed -E 's/^[-* ]+//; s/\*\*//g; s/__//g' "$out/fable.md" | grep -m1 -oE '^Verdict: (approve with changes|approve|redesign|pass|changes_requested)' | sed 's/^Verdict: //' || true)
if [[ -n "$codex_pid" ]]; then
  # Fail closed: untagged Codex output is quoted, not read as clean.
  [[ -n "$findings" ]] || findings="no tagged findings (\"$(head -c 160 "$out/codex.md" | head -1)\")"
  findings="Codex $findings · "
fi
fable_findings=$(grep -oE '^(- )?\[P[0-9]\]' "$out/fable.md" | grep -oE 'P[0-9]' | sort | uniq -c | awk '{printf "%s%s x%s", sep, $2, $1; sep=", "}' || true)
summary="Bob ${note:+design }review at $head: ${findings}Fable ${verdict:-no verdict line, see fable.md}${fable_findings:+ ($fable_findings)}"
printf '%s\n' "$summary"
[[ -n "$note" || -z "$pr_number" ]] || gh pr comment "$pr_number" --repo "$gh" --body "$summary" >/dev/null
