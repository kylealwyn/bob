#!/usr/bin/env python3
"""watch — stream agent state changes that need the conductor.

Subscribes over the Herdr socket to pane.agent_status_changed for every named
agent working in a checkout of this repo (the ones `spawn` started; the user's
own sessions are unnamed and they watch those themselves; workers in other
repos belong to those repos' conductors), and prints one line when an agent
becomes blocked (an approval or question UI), done (finished a turn), or its
pane exits or its agent quits. It also prints each worker already blocked or done when it starts
watching it, since no event will report a transition that came first. Each
line is `<status> <pane> <cwd basename> <terminal title>`.

Agents named after start are picked up live: Herdr emits pane_updated when an
agent is named, and that payload has no name, so each unknown pane is checked
with `herdr agent get` and gets its own subscription when it has one.

Run it as a Claude Code Monitor; each printed line arrives as an event.
"""
import json
import os
import selectors
import socket
import subprocess
import sys

NOTIFY = {"blocked", "done"}

if os.environ.get("HERDR_ENV") != "1":
    sys.exit("watch: not running inside Herdr")


def common_dir(cwd):
    if not cwd:  # git -C "" would mean the current directory
        return None
    try:
        return subprocess.check_output(
            ["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            stderr=subprocess.DEVNULL, text=True).strip()
    except (subprocess.CalledProcessError, FileNotFoundError, NotADirectoryError):
        return None


COMMON = common_dir(os.getcwd()) or sys.exit("watch: run from inside the project's git checkout")
SELF = os.environ.get("HERDR_PANE_ID")

selector = selectors.DefaultSelector()
watched = {}  # pane_id -> agent dict


def subscribe(subscriptions, pane_id=None):
    sock = socket.socket(socket.AF_UNIX)
    sock.connect(os.environ["HERDR_SOCKET_PATH"])
    sock.sendall((json.dumps({"id": "watch", "method": "events.subscribe",
                              "params": {"subscriptions": subscriptions}}) + "\n").encode())
    # Block until Herdr acknowledges, so a status read after this returns can't
    # miss a transition that no event will report.
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(65536)
        if not chunk:
            sys.exit("watch: Herdr closed the socket before acknowledging a subscription")
        buf += chunk
    ack, buf = buf.split(b"\n", 1)
    if "error" in (msg := json.loads(ack)):
        sock.close()
        # A worker's pane can close between the lookup and the subscription;
        # that drops one worker, not the watch.
        if msg["error"].get("code") == "pane_not_found":
            return False
        sys.exit(f"watch: {msg['error']}")
    selector.register(sock, selectors.EVENT_READ, data={"buf": buf, "pane_id": pane_id})
    return True


def agent(pane_id):
    try:
        out = subprocess.check_output(["herdr", "agent", "get", pane_id], stderr=subprocess.DEVNULL)
        return json.loads(out)["result"]["agent"]
    except (subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
        return None


def ours(a):
    return bool(a and a.get("name") and a["pane_id"] != SELF and common_dir(a.get("cwd", "")) == COMMON)


def watch(a):
    if not subscribe([{"type": "pane.agent_status_changed", "pane_id": a["pane_id"]}], a["pane_id"]):
        return
    watched[a["pane_id"]] = a
    # It may have finished or blocked before the subscription began; no event
    # will report that, so report the current status.
    if (now := agent(a["pane_id"])) and now.get("agent_status") in NOTIFY:
        report(now["agent_status"], a["pane_id"])


def forget(pane_id):
    watched.pop(pane_id, None)
    for key in list(selector.get_map().values()):
        if key.data["pane_id"] == pane_id:
            selector.unregister(key.fileobj)
            key.fileobj.close()


def report(status, pane_id):
    a = agent(pane_id) or watched.get(pane_id, {})
    print(f"{status} {pane_id} {os.path.basename(a.get('cwd', '?'))} {a.get('terminal_title_stripped', '')}",
          flush=True)


# Discovery first, so a worker named while the snapshot is taken still arrives
# as a pane_updated event.
subscribe([{"type": "pane.updated"}, {"type": "pane.exited"}])
for a in json.loads(subprocess.check_output(["herdr", "agent", "list"]))["result"]["agents"]:
    if ours(a):
        watch(a)

def handle(line):
    msg = json.loads(line)
    if "error" in msg:
        sys.exit(f"watch: {msg['error']}")
    # Events arrive as {"event": ..., "data": {...}}. Status events use the
    # subscription name (pane.agent_status_changed); general ones use
    # underscores (pane_updated, pane_exited).
    event, data = msg.get("event"), msg.get("data", {})
    if event == "pane.agent_status_changed" and data.get("agent_status") in NOTIFY:
        report(data["agent_status"], data["pane_id"])
    elif event == "pane_exited" and data.get("pane_id") in watched:
        report("exited", data["pane_id"])
        forget(data["pane_id"])
    elif event == "pane_updated":
        pane_id = data.get("pane", {}).get("pane_id")
        if pane_id in watched:
            # The agent can quit or crash back to its shell with the pane still
            # open; no status or exit event says so.
            if agent(pane_id) is None:
                report("exited", pane_id)
                forget(pane_id)
        elif pane_id and ours(a := agent(pane_id)):
            watch(a)


def drain():
    """Handle every complete line already buffered, including lines that arrived
    with a subscription's ack, before waiting on the sockets again."""
    pending = True
    while pending:
        pending = False
        for key in list(selector.get_map().values()):
            while b"\n" in key.data["buf"]:
                line, key.data["buf"] = key.data["buf"].split(b"\n", 1)
                handle(line)
                pending = True


while True:
    drain()
    for key, _ in selector.select():
        chunk = key.fileobj.recv(65536)
        if not chunk:
            if key.data["pane_id"] is None:
                sys.exit("watch: Herdr closed the discovery subscription")
            forget(key.data["pane_id"])
            continue
        key.data["buf"] += chunk
