#!/usr/bin/env bash
# status — one line per live agent in this repo's checkouts, other than the
# orchestrator itself: status, checkout (cwd basename, which is the worktree
# slug), agent name or pane id, and the topic the agent writes into its
# terminal title. Agents that need the user (blocked) sort first, then
# finished ones (done), then the rest.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
require_herdr

repo_agents | jq -rs '
  {blocked: 0, done: 1, unknown: 2, idle: 3, working: 4} as $rank
  | sort_by($rank[.agent_status] // 9)
  | .[]
  | [.agent_status, (.cwd | split("/") | last), (.name // .pane_id), (.terminal_title_stripped // "")]
  | @tsv' | column -t -s $'\t'
