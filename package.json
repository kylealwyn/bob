{
  "name": "bob-engineer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bob's engineering workflow for Pi",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/bob.ts"
    ],
    "skills": [
      "./SKILL.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "^24.0.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_test.py'"
  },
  "engines": {
    "node": ">=24"
  }
}
