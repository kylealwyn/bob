#!/usr/bin/env bash
# close [--abandon] <slug>...
#
# Ends a worker: stops its agent (closes its Herdr workspace, if any), then
# removes the worktree and deletes the branch locally and on origin. Prints one
# line per slug; exits non-zero if any was refused.
#
# It refuses, keeping everything, when the branch has an open PR or the agent
# is mid-turn. It stops leftover dev processes in the tree and discards
# regenerated *.gen.* files. A worker that finished may have parked its
# worktree detached; then it's found by the slug at the end of its path. After
# the agent stops, so nothing written on the way out is missed, it refuses when:
#   - the worktree has uncommitted or untracked files;
#   - origin/<slug> has commits the worktree lacks, unless it's a merged PR's
#     head (a squash merge leaves the branch behind);
#   - the worktree's HEAD or the slug branch's tip is neither on the default
#     branch nor the head of a merged PR, unless --abandon.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

abandon=false
[[ "${1:-}" == --abandon ]] && { abandon=true; shift; }
[[ $# -ge 1 ]] || die "usage: close [--abandon] <slug>..."

gh=$(gh_repo)
git -C "$repo" fetch origin --prune --quiet
failed=0
refuse() { echo "$slug: $*"; failed=1; }

for slug in "$@"; do
  path=$(git -C "$repo" worktree list --porcelain | awk -v want="$slug" '
    /^worktree / {p = substr($0, 10)} /^branch / && $0 == "branch refs/heads/" want {print p; exit}')
  # A worker that finished parks its worktree detached on the default branch,
  # so the branch lookup finds nothing; the worktree is then the detached one
  # spawn created, named by the slug. Only a detached one: another tool's
  # worktree can end in the same name while on its own branch.
  if [[ -z "$path" ]]; then
    path=$(git -C "$repo" worktree list --porcelain | awk -v want="/$slug" '
      /^worktree / {p = substr($0, 10)}
      /^detached$/ && substr(p, length(p) - length(want) + 1) == want {print p}')
    [[ "$(grep -c . <<<"$path")" -le 1 ]] || { refuse "several detached worktrees end in /$slug; remove the worker's by hand"; continue; }
  fi
  [[ -n "$path" ]] || { refuse "no worktree for $slug"; continue; }
  [[ "$path" != "$repo" ]] || { refuse "is the main checkout"; continue; }
  pr=$(gh pr list --repo "$gh" --head "$slug" --state open --json number --jq '.[0].number // empty')
  [[ -z "$pr" ]] || { refuse "PR #$pr is still open, not closing"; continue; }

  # A worker often sends its report before its turn ends (tracker updates,
  # notes); stopping it mid-turn truncates those writes.
  if command -v herdr >/dev/null && [[ "$(herdr agent get "$slug" 2>/dev/null | jq -r '.result.agent.agent_status // empty')" == working ]]; then
    refuse "agent is mid-turn, not closing"; continue
  fi

  # A worker's workspace exists only under Herdr; the Foreman's fast path has none.
  # With no Herdr server running there is no live workspace to stop.
  [[ "${HERDR_ENV:-}" != 1 ]] || command -v herdr >/dev/null || die "inside Herdr but the herdr CLI isn't on PATH"
  if command -v herdr >/dev/null; then
    list=$(herdr worktree list --cwd "$repo" 2>&1 || true)
    code=$(jq -r '.error.code // empty' <<<"$list" 2>/dev/null || echo unparsed)
    [[ -z "$code" || "$code" == server_not_running ]] || die "herdr worktree list failed: $list"
    workspace=$(jq -r --arg p "$path" '.result.worktrees[]? | select(.path == $p) | .open_workspace_id // empty' <<<"$list")
    [[ -z "$workspace" ]] || herdr workspace close "$workspace" >/dev/null
  fi

  # A dev server can outlive its worker with its cwd in the tree, and it
  # regenerates files (*.gen.*) after the last commit; neither is the
  # worker's work. lsof exits 1 on files it can't stat.
  { lsof +D "$path" 2>/dev/null || true; } | awk 'NR > 1 && $4 == "cwd" {print $2}' | sort -u |
    while read -r pid; do kill "$pid" 2>/dev/null || true; done
  git -C "$path" checkout -q -- ':(glob)**/*.gen.*' 2>/dev/null || true

  # Judge every commit that removal would orphan: the worktree's HEAD and,
  # when it exists, the slug branch's tip (a parked worktree's HEAD isn't the
  # branch, and a worker can commit on either).
  tips=$(git -C "$path" rev-parse HEAD; git -C "$repo" rev-parse --verify --quiet "refs/heads/$slug" || true)
  remote_tip=$(git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$slug" || true)
  merged_heads=$(gh pr list --repo "$gh" --head "$slug" --state merged --json headRefOid --jq '.[].headRefOid') ||
    { refuse "agent stopped; couldn't list merged PRs, worktree kept"; continue; }
  merged() { git -C "$repo" merge-base --is-ancestor "$1" "$base" || grep -qx "$1" <<<"$merged_heads"; }
  holds() { local t; while read -r t; do git -C "$repo" merge-base --is-ancestor "$1" "$t" && return 0; done <<<"$tips"; return 1; }
  # origin/<slug> left behind by a squash merge is that PR's head: nothing to lose.
  if [[ -n "$remote_tip" ]] && ! grep -qx "$remote_tip" <<<"$merged_heads" &&
     ! holds "$remote_tip"; then
    refuse "agent stopped; origin/$slug has commits the worktree lacks, worktree kept"; continue
  fi
  if ! $abandon; then
    unmerged=$(while read -r t; do merged "$t" || echo "${t:0:7}"; done <<<"$tips")
    [[ -z "$unmerged" ]] || { refuse "agent stopped; ${unmerged//$'\n'/, } not merged (--abandon discards it), worktree kept"; continue; }
  fi
  if ! err=$(git -C "$repo" worktree remove "$path" 2>&1); then
    refuse "agent stopped; ${err#fatal: }"; continue
  fi
  # A detached worktree's branch may already be gone.
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$slug"; then
    git -C "$repo" branch -D "$slug" >/dev/null
  fi
  # The prune above dropped branches GitHub deleted on merge; the lease keeps a
  # push that landed since.
  if [[ -n "$remote_tip" ]] && ! err=$(git -C "$repo" push origin --delete --force-with-lease="$slug:$remote_tip" "$slug" --quiet 2>&1); then
    refuse "closed, but deleting origin/$slug failed: ${err##*$'\n'}"; continue
  fi
  echo "$slug: closed"
done
exit "$failed"
