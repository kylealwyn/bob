#!/usr/bin/env bash
# Start a Pi Bob Foreman. Native Pi options follow, e.g. --model or --session.
set -euo pipefail
bob=$(cd "$(dirname "$0")/.." && pwd)
provider="${PI_PROVIDER:-}"
resume=false
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[i]}" in
    --provider) provider=${args[i+1]:?--provider needs a provider} ;;
    --session|--resume|-r|--continue|-c) resume=true ;;
  esac
done
model_args=()
$resume || model_args=(--model "$("$bob/scripts/model" foreman "$provider")")
exec pi --extension "$bob/extensions/bob.ts" --skill "$bob/SKILL.md" --bob-role foreman "${model_args[@]}" "$@"
